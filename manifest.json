{
  "manifest_version": 3,
  "name": "ReelHop",
  "version": "2.8.0",
  "description": "Hop from Letterboxd and IMDb to Plex or Radarr in one click, and see which posters are already on your Plex. Unofficial; not affiliated with Letterboxd, IMDb, Plex, or Radarr.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ReelHop settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://plex.tv/*",
    "https://discover.provider.plex.tv/*",
    "https://*.plex.direct/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/*",
        "https://*.imdb.com/title/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
